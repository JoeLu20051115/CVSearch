{
  "schema_version": 3,
  "method": "independent_query_aware_v3",
  "profile": "full",
  "direct_threshold": 0.8,
  "ranking": {
    "alpha": 0.6,
    "beta": 0.5,
    "visual_lambda": 0.5,
    "top_k_augmented": 3,
    "main_query": true,
    "augmented_query": true,
    "complexity": true,
    "edge_density": true
  },
  "modules": {
    "query_ranking": true,
    "adaptive_observation": true,
    "evidence_validation": true
  },
  "budget": {
    "max_steps": 8,
    "max_model_calls": 256,
    "max_processed_pixels": 1600000000
  },
  "controller": {
    "stall_patience": 2,
    "min_progress": 0.02,
    "max_gap_for_stop": 0.2,
    "min_answer_confidence": 0.65,
    "min_support_avg": 0.7,
    "min_support_min": 0.5
  },
  "global_gate": {
    "min_support": 0.8,
    "min_margin": 0.2,
    "min_consistency": 0.75
  },
  "proposals": {
    "dedup_iou": 0.9,
    "min_count": 1,
    "min_spatial_coverage": 0.005,
    "active_top_k": 4
  },
  "acceptance": {
    "min_absolute_support": 0.65,
    "min_normalized_margin": 0.15,
    "min_view_support": 0.6,
    "aggregation": "global_verifier_then_branch_equal_mean",
    "global_verifier_min_support": 0.65,
    "global_verifier_min_margin": 0.15
  },
  "verification": {
    "labels": [
      "Support",
      "Refute",
      "Insufficient"
    ],
    "grounding_labels": [
      "Grounded",
      "NotGrounded",
      "Insufficient"
    ],
    "grounding_threshold": 0.65,
    "target_instance_iou": 0.5
  },
  "observation_geometry": {
    "min_zoom_factor": 0.4,
    "context_max_normalized_gap": 0.25
  }
}
